<!--
    Banner (spec §2.3): a tinted strip with a 3 px left bar, an icon glyph, the message and an optional ghost action.
    The base look is Warning; Severity="Info" switches to the Accent colour. Fill and border are the status colour
    at 8 % and 25 % alpha (as in the mockup), taken from the token colours.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:RhythmSync.App.Controls">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Tokens.xaml" />
        <ResourceDictionary Source="Buttons.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <SolidColorBrush x:Key="BannerWarningFill" Color="{StaticResource WarningColor}" Opacity="0.08" />
    <SolidColorBrush x:Key="BannerWarningBorder" Color="{StaticResource WarningColor}" Opacity="0.25" />
    <SolidColorBrush x:Key="BannerInfoFill" Color="{StaticResource AccentColor}" Opacity="0.08" />
    <SolidColorBrush x:Key="BannerInfoBorder" Color="{StaticResource AccentColor}" Opacity="0.25" />

    <Style TargetType="c:Banner">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:Banner">
                    <Border x:Name="Root" Background="{StaticResource BannerWarningFill}" BorderBrush="{StaticResource BannerWarningBorder}"
                            BorderThickness="1" CornerRadius="{StaticResource RadiusControl}" SnapsToDevicePixels="True">
                        <Grid>
                            <Border x:Name="Bar" Width="3" HorizontalAlignment="Left" CornerRadius="8,0,0,8"
                                    Background="{StaticResource WarningBrush}" />
                            <Grid Margin="12,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="PART_Glyph" Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center"
                                           FontFamily="{StaticResource FontIcons}" FontSize="14" Text="&#xE7BA;"
                                           Foreground="{StaticResource WarningBrush}" AutomationProperties.Name="Warning" />
                                <TextBlock x:Name="PART_Message" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap"
                                           FontSize="12" Foreground="{StaticResource TextBrush}" Text="{TemplateBinding Message}" />
                                <Button x:Name="PART_Action" Grid.Column="2" Margin="10,0,0,0" Padding="8,4" VerticalAlignment="Center"
                                        Style="{StaticResource GhostButton}" Visibility="Collapsed"
                                        Content="{TemplateBinding ActionText}" Command="{TemplateBinding ActionCommand}" />
                            </Grid>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasAction" Value="True">
                            <Setter TargetName="PART_Action" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Severity" Value="Info">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource BannerInfoFill}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource BannerInfoBorder}" />
                            <Setter TargetName="Bar" Property="Background" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="PART_Glyph" Property="Text" Value="&#xE946;" />
                            <Setter TargetName="PART_Glyph" Property="Foreground" Value="{StaticResource AccentSoftBrush}" />
                            <Setter TargetName="PART_Glyph" Property="AutomationProperties.Name" Value="Information" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
