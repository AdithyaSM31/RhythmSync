<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:RhythmSync.App.Controls">
    <!-- Everything App.xaml puts in Application.Resources. Kept in its own dictionary so the UI tests can load it into a
         plain Application without constructing the real App (whose OnStartup starts services, the tray and netsh). -->
    <ResourceDictionary.MergedDictionaries>
        <!-- The "Dark studio" design system: tokens plus every control style. -->
        <ResourceDictionary Source="Studio.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <c:SyncStateToKindConverter x:Key="SyncStateToKind" />

    <!-- A text line that disappears while it has nothing to say. -->
    <Style x:Key="OptionalText" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
