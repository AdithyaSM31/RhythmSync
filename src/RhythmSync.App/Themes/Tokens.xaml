<!-- Design tokens for the "Dark studio" theme (spec §2.1). Every colour has a Color and a SolidColorBrush. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Colours -->
    <Color x:Key="BgColor">#0E0F13</Color>
    <Color x:Key="SurfaceColor">#14161C</Color>
    <Color x:Key="CardColor">#161921</Color>
    <Color x:Key="CardBorderColor">#232733</Color>
    <Color x:Key="RaisedColor">#1D2029</Color>
    <Color x:Key="RaisedBorderColor">#2A2E3B</Color>
    <Color x:Key="TrackColor">#262A36</Color>
    <Color x:Key="TextColor">#E8E9EE</Color>
    <Color x:Key="TextMutedColor">#8A8F9C</Color>
    <Color x:Key="AccentColor">#8B7CFF</Color>
    <Color x:Key="AccentSoftColor">#B4ABFF</Color>
    <Color x:Key="TealColor">#4FD1C5</Color>
    <Color x:Key="WarningColor">#F5B94A</Color>
    <Color x:Key="DangerColor">#FF6B7A</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorderColor}" />
    <SolidColorBrush x:Key="RaisedBrush" Color="{StaticResource RaisedColor}" />
    <SolidColorBrush x:Key="RaisedBorderBrush" Color="{StaticResource RaisedBorderColor}" />
    <SolidColorBrush x:Key="TrackBrush" Color="{StaticResource TrackColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
    <SolidColorBrush x:Key="TealBrush" Color="{StaticResource TealColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />

    <!-- Violet to teal, left to right: slider fill and the toggle's on state. -->
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="{StaticResource AccentColor}" />
        <GradientStop Offset="1" Color="{StaticResource TealColor}" />
    </LinearGradientBrush>

    <!-- Radii -->
    <CornerRadius x:Key="RadiusCard">12</CornerRadius>
    <CornerRadius x:Key="RadiusControl">9</CornerRadius>
    <CornerRadius x:Key="RadiusSmall">6</CornerRadius>
    <CornerRadius x:Key="RadiusPill">12</CornerRadius>

    <!-- Motion: one full cycle of the Syncing chip pulse (opacity 1 to 0.5 and back). -->
    <Duration x:Key="PulseDuration">0:0:1.6</Duration>
    <!-- Motion: the tray flyout's entrance (slide up 12 px and fade in, cubic ease-out). -->
    <Duration x:Key="FlyoutSlideDuration">0:0:0.15</Duration>

    <!-- Fonts (each falls back to the next family when the first is missing) -->
    <FontFamily x:Key="FontUi">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="FontMono">Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="FontIcons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Type ramp. Only Caption and Display set a colour; the rest inherit Text from the window. -->
    <Style x:Key="DisplayText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="{StaticResource AccentColor}" BlurRadius="18" Opacity="0.45" ShadowDepth="0" />
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="TitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="SubtitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style x:Key="CaptionText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
    </Style>
    <Style x:Key="StatText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
    </Style>

</ResourceDictionary>
