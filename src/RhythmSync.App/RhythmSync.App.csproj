<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>RhythmSync.App</RootNamespace>
    <AssemblyName>RhythmSync</AssemblyName>
    <ApplicationIcon>Assets\RhythmSync.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF and WinForms both define Application, MessageBox, ...; the few WinForms types the tray uses are named explicitly. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RhythmSync.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The logo: the exe icon (ApplicationIcon) and, as a WPF resource, the window, title-bar and tray icon via pack://application:,,,/RhythmSync;component/Assets/RhythmSync.ico. -->
    <Resource Include="Assets\RhythmSync.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RhythmSync.Core\RhythmSync.Core.csproj" />
    <ProjectReference Include="..\RhythmSync.Platform.Windows\RhythmSync.Platform.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

</Project>
