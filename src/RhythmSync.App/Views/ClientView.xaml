<UserControl x:Class="RhythmSync.App.Views.ClientView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RhythmSync.App.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
            <TextBlock Text="Hosts on this network" FontWeight="SemiBold" Margin="0,0,0,6" />
            <ListBox ItemsSource="{Binding Hosts}" SelectedItem="{Binding SelectedHost, Mode=TwoWay}"
                     MinHeight="110" MaxHeight="180" AutomationProperties.Name="Hosts on this network">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding ControlEndPoint.Address}"
                                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="{Binding HostListMessage}" Style="{StaticResource OptionalText}" Margin="0,6,0,0"
                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />

            <DockPanel Margin="0,14,0,0" LastChildFill="False">
                <TextBlock Text="Code" VerticalAlignment="Center" Margin="0,0,8,0" DockPanel.Dock="Left" />
                <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" MaxLength="4" Width="80" FontSize="18"
                         HorizontalContentAlignment="Center" DockPanel.Dock="Left" AutomationProperties.Name="Pairing code" />
                <Button Content="Join" Command="{Binding JoinCommand}" IsDefault="True" Width="80" Padding="0,5"
                        DockPanel.Dock="Right" />
            </DockPanel>
            <TextBlock Text="{Binding ErrorText}" Style="{StaticResource OptionalText}" Foreground="#B00020" Margin="0,8,0,0" />

            <Separator Margin="0,14" />

            <TextBlock Text="{Binding StatusText}" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource OptionalText}" Foreground="#B45F06" Margin="0,4,0,0" />
            <TextBlock Text="{Binding SyncErrorText}" Margin="0,8,0,0" />
            <TextBlock Text="{Binding DriftText}" />
            <TextBlock Text="{Binding CountersText}" />

            <!-- Read-only: the host is the single source of truth for this PC's volume and offset. -->
            <TextBlock Text="{Binding VolumeText}" Margin="0,16,0,0" />
            <TextBlock Text="{Binding OffsetText}" Margin="0,4,0,0" />
            <TextBlock Text="{x:Static vm:ClientViewModel.SetOnHostText}" Margin="0,2,0,0"
                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />

            <Button Content="Leave" Command="{Binding LeaveCommand}" HorizontalAlignment="Left" Width="80" Padding="0,5" Margin="0,16,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
