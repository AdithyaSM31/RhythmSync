<UserControl x:Class="RhythmSync.App.Views.HostView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:RhythmSync.App.Views">
    <!-- The running host. DataContext: a HostViewModel. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
            <Border Background="#FFF4CE" Padding="10,8" Margin="0,0,0,12"
                    Visibility="{Binding HasAudioBanner, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{Binding AudioBanner}" TextWrapping="Wrap" Foreground="#3B2F00" />
                    <Button Content="Open sound settings" Command="{Binding OpenSoundSettingsCommand}"
                            HorizontalAlignment="Left" Padding="10,3" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Text="Pairing code" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
            <TextBlock Text="{Binding PairingCode}" FontSize="40" FontWeight="Bold" FontFamily="Consolas"
                       AutomationProperties.Name="Pairing code" />

            <TextBlock Text="Session name" Margin="0,12,0,2" />
            <TextBox Text="{Binding SessionName, UpdateSourceTrigger=PropertyChanged}" MaxLength="64"
                     AutomationProperties.Name="Session name" />

            <TextBlock Text="{Binding LatencyText}" Margin="0,14,0,0" />
            <Slider Minimum="100" Maximum="500" TickFrequency="10" IsSnapToTickEnabled="True" SmallChange="10" LargeChange="50"
                    Value="{Binding LatencyMs, Mode=TwoWay}" AutomationProperties.Name="Latency in milliseconds" />
            <TextBlock Text="Higher latency is more robust on a weak Wi-Fi connection."
                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" TextWrapping="Wrap" />

            <Separator Margin="0,14" />

            <DockPanel LastChildFill="False">
                <TextBlock Text="Connected PCs" FontWeight="SemiBold" DockPanel.Dock="Left" VerticalAlignment="Center" />
                <CheckBox Content="Show stats" IsChecked="{Binding ShowStats}" DockPanel.Dock="Right" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Text="Waiting for PCs to join…" Margin="0,8,0,0"
                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                       Visibility="{Binding HasNoClients, Converter={StaticResource BoolToVisibility}}" />

            <ItemsControl ItemsSource="{Binding Clients}" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" BorderThickness="1"
                                CornerRadius="3" Padding="10,8" Margin="0,0,0,8">
                            <StackPanel>
                                <DockPanel LastChildFill="False">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" DockPanel.Dock="Left" />
                                    <TextBlock Text="{Binding StatusText}" DockPanel.Dock="Right"
                                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                                </DockPanel>
                                <TextBlock Text="{Binding CongestedText}" Style="{StaticResource OptionalText}"
                                           Foreground="#B45F06" Margin="0,4,0,0" />

                                <TextBlock Text="{Binding VolumeText}" Margin="0,8,0,0" />
                                <Slider Minimum="0" Maximum="1" LargeChange="0.1" SmallChange="0.01" Value="{Binding Volume, Mode=TwoWay}"
                                        AutomationProperties.Name="{Binding Name, StringFormat='Volume of {0}'}" />
                                <TextBlock Text="{Binding OffsetText}" Margin="0,6,0,0" />
                                <Slider Minimum="-100" Maximum="100" LargeChange="10" SmallChange="1" TickFrequency="10" TickPlacement="BottomRight"
                                        Value="{Binding OffsetMs, Mode=TwoWay}"
                                        AutomationProperties.Name="{Binding Name, StringFormat='Offset of {0} in milliseconds'}" />

                                <views:StatsPanel Visibility="{Binding DataContext.ShowStats, RelativeSource={RelativeSource AncestorType=views:HostView}, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
