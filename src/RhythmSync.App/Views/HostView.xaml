<UserControl x:Class="RhythmSync.App.Views.HostView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:RhythmSync.App.Controls"
             xmlns:views="clr-namespace:RhythmSync.App.Views">
    <!-- The running host (spec 4.2), below the page header. DataContext: a HostViewModel. -->
    <ScrollViewer x:Name="HostScroll" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,12,4">
            <c:Banner Message="{Binding AudioBanner}" ActionText="Open sound settings" ActionCommand="{Binding OpenSoundSettingsCommand}"
                      Margin="0,0,0,12" Visibility="{Binding HasAudioBanner, Converter={StaticResource BoolToVisibility}}" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1.4*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Pairing code" Style="{StaticResource CaptionText}" />
                        <!-- One TextBlock per character: WPF has no letter spacing. The negative margin takes back the gap after the last one. -->
                        <ItemsControl ItemsSource="{Binding PairingCode}" Margin="0,6,-8,6" AutomationProperties.Name="{Binding PairingCode, StringFormat='Pairing code {0}'}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource DisplayText}" Margin="0,0,8,0" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Share this with the other PCs" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="{Binding LatencyText}" Style="{StaticResource BodyText}" />
                        <!-- Delay: a drag (or a run of key presses) commits once, 300 ms after it stops, not at every 10 ms step. -->
                        <Slider Minimum="100" Maximum="500" TickFrequency="10" IsSnapToTickEnabled="True" SmallChange="10" LargeChange="50"
                                Value="{Binding LatencyMs, Mode=TwoWay, Delay=300}" Margin="0,6,0,4"
                                AutomationProperties.Name="Latency in milliseconds" />
                        <TextBlock Text="Higher latency is more robust on a weak Wi-Fi connection."
                                   Style="{StaticResource CaptionText}" TextWrapping="Wrap" />

                        <TextBlock Text="Play on this PC through" Style="{StaticResource CaptionText}" Margin="0,12,0,4" />
                        <ContentPresenter Content="{Binding SpeakerPicker, RelativeSource={RelativeSource AncestorType=views:HostView}}" />

                        <TextBlock Text="Session name" Style="{StaticResource CaptionText}" Margin="0,12,0,4" />
                        <TextBox Text="{Binding SessionName, UpdateSourceTrigger=PropertyChanged}" MaxLength="64"
                                 AutomationProperties.Name="Session name" />
                    </StackPanel>
                </Border>
            </Grid>

            <DockPanel Margin="0,22,0,10" LastChildFill="False">
                <TextBlock Text="Connected PCs" Style="{StaticResource SubtitleText}" DockPanel.Dock="Left" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Clients.Count}" Style="{StaticResource CaptionText}" DockPanel.Dock="Left"
                           Margin="8,0,0,0" VerticalAlignment="Center" />
                <CheckBox Content="Show stats" IsChecked="{Binding ShowStats}" Style="{StaticResource ToggleSwitch}"
                          DockPanel.Dock="Right" VerticalAlignment="Center" />
            </DockPanel>

            <Border Style="{StaticResource CardBorder}" Visibility="{Binding HasNoClients, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Waiting for PCs to join…" Style="{StaticResource CaptionText}" HorizontalAlignment="Center" />
            </Border>

            <ItemsControl ItemsSource="{Binding Clients}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="120" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource SubtitleText}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <c:StatusChip Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding StatusText}"
                                                  Kind="{Binding State, Converter={StaticResource SyncStateToKind}}" />
                                    <TextBlock Grid.Column="2" Text="{Binding SyncErrorText}" Style="{StaticResource StatText}"
                                               Margin="12,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                                <!-- On its own line, so the warning never takes the name's room (it wraps when the window is narrow). -->
                                <TextBlock Text="{Binding CongestedText}" Style="{StaticResource OptionalText}"
                                           FontSize="11" Foreground="{StaticResource WarningBrush}" TextAlignment="Right" Margin="0,6,0,0" />

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding VolumeText}" Style="{StaticResource CaptionText}" />
                                        <Slider Minimum="0" Maximum="1" LargeChange="0.1" SmallChange="0.01" Value="{Binding Volume, Mode=TwoWay}" Margin="0,4,0,0"
                                                AutomationProperties.Name="{Binding Name, StringFormat='Volume of {0}'}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding OffsetText}" Style="{StaticResource CaptionText}" />
                                        <Slider Minimum="-100" Maximum="100" LargeChange="10" SmallChange="1" TickFrequency="10"
                                                Value="{Binding OffsetMs, Mode=TwoWay}" Margin="0,4,0,0"
                                                AutomationProperties.Name="{Binding Name, StringFormat='Offset of {0} in milliseconds'}" />
                                    </StackPanel>
                                </Grid>

                                <views:StatsPanel Visibility="{Binding DataContext.ShowStats, RelativeSource={RelativeSource AncestorType=views:HostView}, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
