<UserControl x:Class="RhythmSync.App.Views.HostTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:RhythmSync.App.Controls"
             xmlns:views="clr-namespace:RhythmSync.App.Views">
    <!-- The Host page. DataContext: a HostTabViewModel. -->
    <Grid>
        <!-- Before hosting: one centred card (spec 4.1). The scroller only matters when the window is smaller than the card. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsNotHosting, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource CardBorder}" Width="360" Padding="24,22" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock HorizontalAlignment="Center" FontFamily="{StaticResource FontIcons}" FontSize="32" Text="&#xE7F5;"
                               Foreground="{StaticResource AccentBrush}">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="{StaticResource AccentColor}" BlurRadius="20" Opacity="0.5" ShadowDepth="0" />
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock Text="Share this PC's audio" Style="{StaticResource TitleText}" TextAlignment="Center"
                               TextWrapping="Wrap" Margin="0,10,0,0" />
                    <TextBlock Text="Other PCs on your Wi-Fi can join with the pairing code and play in sync."
                               Style="{StaticResource CaptionText}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0" />

                    <TextBlock Text="Session name" Style="{StaticResource CaptionText}" Margin="0,18,0,4" />
                    <TextBox Text="{Binding SessionName, UpdateSourceTrigger=PropertyChanged}" MaxLength="64"
                             AutomationProperties.Name="Session name" />

                    <TextBlock Text="Play on this PC through" Style="{StaticResource CaptionText}" Margin="0,12,0,4" />
                    <ComboBox ItemsSource="{Binding Speakers}" SelectedItem="{Binding SelectedSpeaker, Mode=TwoWay}" DisplayMemberPath="Name"
                              AutomationProperties.Name="Speakers for local playback" />

                    <Button Content="Start hosting" Command="{Binding StartCommand}" IsDefault="True"
                            Style="{StaticResource PrimaryButton}" Padding="16,10" Margin="0,20,0,0" />
                    <TextBlock Text="{Binding ErrorText}" Style="{StaticResource OptionalText}"
                               Foreground="{StaticResource DangerBrush}" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- While hosting: the fixed header, then the running host (which scrolls). -->
        <DockPanel Visibility="{Binding IsHosting, Converter={StaticResource BoolToVisibility}}">
            <!-- The name trims first; the Hosting chip follows it and only the Stop button sits on the right. -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <c:LeadingShrinkPanel Grid.Column="0">
                    <!-- Display only: the name is edited in the settings card below. -->
                    <TextBlock Text="{Binding Current.SessionName}" Style="{StaticResource TitleText}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <c:StatusChip Margin="12,0,0,0" VerticalAlignment="Center" Kind="Hosting" Text="Hosting" />
                </c:LeadingShrinkPanel>
                <Button Grid.Column="1" Content="Stop hosting" Command="{Binding StopCommand}" Margin="12,0,0,0"
                        Style="{StaticResource DangerButton}" Padding="14,7" />
            </Grid>

            <!-- The banners may ask for other speakers, so the picker can be changed while hosting (the VB-CABLE is not listed). -->
            <views:HostView x:Name="RunningHost" DataContext="{Binding Current}">
                <views:HostView.SpeakerPicker>
                    <ComboBox ItemsSource="{Binding Speakers}" SelectedItem="{Binding SelectedSpeaker, Mode=TwoWay}" DisplayMemberPath="Name"
                              AutomationProperties.Name="Speakers for local playback while hosting" />
                </views:HostView.SpeakerPicker>
            </views:HostView>
        </DockPanel>
    </Grid>
</UserControl>
