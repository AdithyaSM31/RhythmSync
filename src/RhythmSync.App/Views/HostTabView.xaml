<UserControl x:Class="RhythmSync.App.Views.HostTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:RhythmSync.App.Views">
    <!-- The Host tab. DataContext: a HostTabViewModel. -->
    <Grid>
        <!-- Before hosting -->
        <StackPanel Margin="12" Visibility="{Binding IsNotHosting, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Share this PC's audio" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="Other PCs on your Wi-Fi can join with the pairing code and play in sync."
                       TextWrapping="Wrap" Margin="0,2,0,12" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />

            <TextBlock Text="Session name" Margin="0,0,0,2" />
            <TextBox Text="{Binding SessionName, UpdateSourceTrigger=PropertyChanged}" MaxLength="64"
                     AutomationProperties.Name="Session name" />

            <TextBlock Text="Play on this PC through" Margin="0,12,0,2" />
            <ComboBox ItemsSource="{Binding Speakers}" SelectedItem="{Binding SelectedSpeaker, Mode=TwoWay}" DisplayMemberPath="Name"
                      AutomationProperties.Name="Speakers for local playback" />

            <Button Content="Start hosting" Command="{Binding StartCommand}" IsDefault="True" HorizontalAlignment="Left"
                    Width="120" Padding="0,5" Margin="0,16,0,0" />
            <TextBlock Text="{Binding ErrorText}" Style="{StaticResource OptionalText}" Foreground="#B00020" Margin="0,8,0,0" />
        </StackPanel>

        <!-- While hosting -->
        <DockPanel Visibility="{Binding IsHosting, Converter={StaticResource BoolToVisibility}}">
            <Button DockPanel.Dock="Bottom" Content="Stop hosting" Command="{Binding StopCommand}" HorizontalAlignment="Left"
                    Width="120" Padding="0,5" Margin="12,6,12,12" />
            <views:HostView DataContext="{Binding Current}" />
        </DockPanel>
    </Grid>
</UserControl>
