<UserControl x:Class="RhythmSync.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The Settings page (spec 4.4). DataContext: a SettingsViewModel. The scroller only matters at the window's minimum height. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel MaxWidth="560" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource TitleText}" Margin="0,0,0,14" />

            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <!-- This PC's name: saved on Enter or when the box loses focus. -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="This PC's name" Style="{StaticResource SubtitleText}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="Shown to the host and other PCs" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                        <TextBox x:Name="NameBox" Grid.Column="1" Width="190" Margin="16,0,0,0" VerticalAlignment="Center"
                                 Text="{Binding DeviceName, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="This PC's name" LostFocus="OnNameLostFocus">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding CommitNameCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding NameErrorText}" Style="{StaticResource OptionalText}"
                                   Foreground="{StaticResource DangerBrush}" FontSize="12" Margin="0,8,0,0" />
                    </Grid>

                    <Rectangle Height="1" Fill="{StaticResource CardBorderBrush}" Margin="0,14" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Start with Windows" Style="{StaticResource SubtitleText}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="Launch RhythmSync when you sign in" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" Margin="16,0,0,0" VerticalAlignment="Center"
                                  IsChecked="{Binding StartWithWindows, Mode=TwoWay}" AutomationProperties.Name="Start with Windows" />
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding StartupErrorText}" Style="{StaticResource OptionalText}"
                                   Foreground="{StaticResource DangerBrush}" FontSize="12" Margin="0,8,0,0" />
                    </Grid>

                    <Rectangle Height="1" Fill="{StaticResource CardBorderBrush}" Margin="0,14" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Start minimized" Style="{StaticResource SubtitleText}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="Open straight to the tray" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" Margin="16,0,0,0" VerticalAlignment="Center"
                                  IsChecked="{Binding StartMinimized, Mode=TwoWay}" AutomationProperties.Name="Start minimized" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="About" Style="{StaticResource SubtitleText}" />
                    <TextBlock Text="{Binding VersionText}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <WrapPanel Margin="0,12,0,0">
                        <Button Content="Open log folder" Command="{Binding OpenLogFolderCommand}" Style="{StaticResource SecondaryButton}"
                                Padding="14,7" Margin="0,0,8,0" AutomationProperties.Name="Open log folder" />
                        <Button Content="Open settings folder" Command="{Binding OpenSettingsFolderCommand}" Style="{StaticResource SecondaryButton}"
                                Padding="14,7" AutomationProperties.Name="Open settings folder" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
