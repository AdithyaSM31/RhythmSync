<Window x:Class="RhythmSync.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:RhythmSync.App.Views"
        Title="RhythmSync" Width="460" Height="680" MinWidth="380" MinHeight="520"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#FFF4CE" Padding="12,8"
                Visibility="{Binding ShowPublicNetworkWarning, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding PublicNetworkWarningText}" TextWrapping="Wrap" Foreground="#3B2F00" />
        </Border>
        <TabControl Margin="8">
            <TabItem Header="Client">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="12,8,12,0" TextWrapping="Wrap"
                               Text="This PC is hosting – stop hosting to join another host.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ClientEnabled}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <views:ClientView DataContext="{Binding Client}" IsEnabled="{Binding DataContext.ClientEnabled, RelativeSource={RelativeSource AncestorType=Window}}" />
                </DockPanel>
            </TabItem>
            <TabItem Header="Host">
                <views:HostTabView DataContext="{Binding Host}" />
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
